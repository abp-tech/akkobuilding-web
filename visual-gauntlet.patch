diff --git a/dist/v2/layout-contract.css b/dist/v2/layout-contract.css
new file mode 100644
index 0000000..923c1e4
--- /dev/null
+++ b/dist/v2/layout-contract.css
@@ -0,0 +1,34 @@
+/* Shared page grid. Keep photography full bleed; align its text with other routes. */
+@layer akko-legacy, akko-layout, akko-type;
+@layer akko-layout {
+ :root{--page-gutter-start:24px;--page-gutter-end:24px;--content-left:var(--page-gutter-start);--content-right:var(--page-gutter-end);}
+ @media(min-width:480px){:root{--page-gutter-start:40px;--page-gutter-end:40px;}}
+ @media(min-width:990px){:root{--page-gutter-start:120px;}}
+ @media(min-width:1200px){:root{--page-gutter-start:max(176px,calc((100vw - 2042px)/2 + 176px));--page-gutter-end:max(94.4px,calc((100vw - 2042px)/2 + 94.4px));}}
+ .shared-ui main .section,.shared-ui .services-section,.shared-ui.page-services #hablemos{padding-inline:var(--page-gutter-start) var(--page-gutter-end);}
+ .shared-ui .services-hero__content{padding-inline:var(--page-gutter-start) var(--page-gutter-end);}
+ .shared-ui .services-hero__credit{left:auto;right:var(--page-gutter-end);}
+ .shared-ui .services-pause figcaption{left:var(--page-gutter-start);right:var(--page-gutter-end);}
+ .shared-ui .vertical-nav>p,.shared-ui .list-header{color:#626262;opacity:1;}
+ /* A title must wrap at spaces, never within a word just to keep a narrow column. */
+ .page-company .company-news-swiper .journal-card__title{overflow-wrap:normal;word-break:normal;}
+ @media(min-width:990px) and (max-width:1199px){
+  .page-company .section-journalcards{display:block;}
+  .page-company .section-journalcards .journal-cards__intro{display:block;width:100%;padding-bottom:3rem;}
+  .page-company .section-journalcards .journal-cards__intro .content{position:static;}
+  .page-company .section-journalcards .journal-cards__intro .content>:first-child{margin-bottom:2rem;max-width:16em;}
+  .page-company .section-journalcards .journal-cards__grid{width:100%;padding:0;border-left:0;}
+ }
+ @media(min-width:1200px){
+  .page-id-home .home-projects-swiper .project-card .heading{width:36%;overflow-wrap:normal;word-break:normal;}
+  .page-id-home .home-projects-swiper .project-card .media-wrap{width:calc(64% - 1rem);}
+ }
+ @media(max-width:479px){
+  .shared-ui .services-hero__credit{left:var(--page-gutter-start);right:var(--page-gutter-end);}
+  /* Categories remain visible and keyboard reachable instead of a hidden horizontal strip. */
+  .shared-ui .vertical-nav-wrap{overflow:visible;margin-inline:0;}
+  .shared-ui .vertical-nav-wrap .vertical-nav{white-space:normal;overflow:visible;padding:0;}
+  .shared-ui .vertical-nav-wrap .vertical-nav ul{display:flex;flex-wrap:wrap;gap:10px 16px;}
+  .shared-ui .vertical-nav-wrap .vertical-nav li{margin:0;}
