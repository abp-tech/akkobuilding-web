new file mode 100644
index 0000000..8ad31e2
--- /dev/null
+++ b/scripts/audit-visual-contract.py
@@ -0,0 +1,53 @@
+"""Validate generated routes and optionally the CUA responsive matrix.
+Usage: python scripts/audit-visual-contract.py [--matrix path/to/matrix.json]
+Requires beautifulsoup4 (the existing generators' dependency).
+"""
+from pathlib import Path
+from urllib.parse import urlsplit,unquote
+import argparse,json,re
+from bs4 import BeautifulSoup
+ROOT=Path(__file__).resolve().parents[1]
+def audit(matrix=None):
+ errors=[];pages=[]
+ for p in sorted((ROOT/'dist').rglob('*.html')):
+  s=BeautifulSoup(p.read_text(),'html.parser')
+  if not s.main:continue
+  page=str(p.relative_to(ROOT/'dist'));pages.append(page)
+  if len(s.select('h1'))!=1:errors.append([page,'Expected exactly one H1'])
+  level=0
+  for h in s.main.select('h1,h2,h3,h4,h5,h6'):
+   n=int(h.name[1])
+   if n>level+1:errors.append([page,'Heading level skipped',h.get_text(' ',strip=True)])
+   level=n
+  for el in s.select('[href],[src]'):
+   for attr in ['href','src']:
+    u=urlsplit(el.get(attr,''))
+    if u.netloc or not u.path.startswith('/'):continue
+    target=ROOT/'dist'/unquote(u.path[1:])
+    if u.path.endswith('/'):target=target/'index.html'
+    if not target.exists():errors.append([page,'Missing resource',u.path])
+ for p in (ROOT/'dist').rglob('*'):
+  if p.suffix in {'.html','.css','.js','.json'} and re.search(r'PPFraktionMono|SequelSans|ResidentialSequel',p.read_text()):errors.append([str(p),'Legacy font reference'])
+ views=[];variants={}
+ if matrix:
+  records=json.loads(Path(matrix).read_text());dedup={}
+  for r in records:
+   if r.get('phase')=='after' and r.get('captures'):dedup[r['path'],r['width']]=r
+  views=list(dedup.values());widths={375,430,768,1024,1440,1920}
+  for path in {r['path'] for r in views}:
+   found={r['width'] for r in views if r['path']==path}
+   if found!=widths:errors.append([path,'Incomplete breakpoint coverage',sorted(found)])
+  if len(views)!=len(pages)*6:errors.append(['matrix','Incomplete route count',len(views)])
+  for r in views:
+   for c in r['captures']:
+    if c['overflow']>1 or c['clipped'] or c['broken']:errors.append([r['path'],r['width'],c['stage'],'Layout regression'])
+   for f in r['fonts']:
+    size=float(f['size'].removesuffix('px'));tracking=0 if f['tracking']=='normal' else round(float(f['tracking'].removesuffix('px'))/size,4)
+    line=round(float(f['line'].removesuffix('px'))/size,3)
+    key=(r['path'],f['role'],f['tag'],f['text']);value=(f['family'],f['weight'],tracking,line)
+    if key in variants and variants[key]!=value:errors.append([r['path'],r['width'],'Variant changed',f['text']])
+    variants[key]=value
+ print(json.dumps({'pages':len(pages),'views':len(views),'captures':sum(len(r['captures']) for r in views),'errors':errors},ensure_ascii=False,indent=2))
+ return bool(errors)
+if __name__=='__main__':
+ p=argparse.ArgumentParser();p.add_argument('--matrix');args=p.parse_args();raise SystemExit(audit(args.matrix))
